{
  "name": "nexus-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "start": "node scripts/start.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:ui": "node scripts/test-ui.mjs",
    "setup": "node scripts/setup.mjs",
    "api": "node scripts/api.mjs",
    "test:backend": "node scripts/test-backend.mjs",
    "test:live": "node scripts/test-live.mjs",
    "test:tooling": "node --test scripts/runtime.test.mjs",
    "build:api": "node scripts/dotnet.mjs build backend/Nexus.Api/Nexus.Api.csproj"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
