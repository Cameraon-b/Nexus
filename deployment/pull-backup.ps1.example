# REVIEW ONLY. Copy to a private operator-managed script after independent review.
# Task Scheduler: daily nominal schedule only; no producer/pull ordering guarantee.
# 03:00 local = 09:00 UTC CST / 08:00 UTC CDT; Nora uses 08:15 UTC + jitter.
# Persistent catch-up can overlap. A zero-transfer pull may pass freshness under 36 hours.
# Run whether logged on or not; do not start a second instance; no elevation by default.
# Program: powershell.exe; arguments: -NoProfile -NonInteractive -File <private script>
# Start in the reviewed candidate, never the mutable repository. Register no task here.
# Pre-provision known_hosts using an independently verified host fingerprint.
# Operator must install the complete reviewed content-addressed candidate/dependencies
# with read-only operator ACLs first. Path checks do not attest review or immutable custody.
# Candidate SHA256 identifies the operational bundle, including pre-commit acceptance trees.
param(
  [string]$recipientFingerprint = '<APPROVED_RECIPIENT_BYTES_SHA256>',
  [string]$candidateId = '<REVIEWED_CANDIDATE_SHA256>',
  [string]$candidate = 'C:\Nexus Backup\tools\candidates\<REVIEWED_CANDIDATE_SHA256>',
  [string]$trustedVerifier = 'C:\Nexus Backup\trusted\verify-production-candidate.ps1',
  [string]$trustedVerifierSha256 = '<SEPARATELY_APPROVED_VERIFIER_BYTES_SHA256>'
)
$ErrorActionPreference = 'Stop'
# Public independent pin: never infer it from downloaded metadata.
if ($recipientFingerprint.Length -ne 64 -or $recipientFingerprint -cnotmatch '^[0-9a-f]{64}$') { throw 'Approved recipient-byte SHA256 required.' }
if ($candidateId -cnotmatch '^[0-9a-f]{64}$') { throw 'Reviewed candidate SHA256 required.' }
$expected = 'C:\Nexus Backup\tools\candidates\' + $candidateId
if ($candidate -cne $expected -or [System.IO.Path]::GetFullPath($candidate) -cne $expected) {
  throw 'Exact reviewed immutable candidate path required.'
}
# Reject junction/symlink redirection in the candidate or any ancestor.
$item = Get-Item -LiteralPath $candidate -Force
if (-not $item.PSIsContainer) { throw 'Reviewed candidate directory required.' }
while ($null -ne $item) {
  if (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
    throw 'Candidate redirection refused.'
  }
  $item = $item.Parent
}
# One standalone verifier, installed outside the candidate, separately pinned by
# exact bytes. It checks CANDIDATE_ID, manifest hash, exact inventory, single-link
# members and read-only custody before any candidate Node module is loaded.
if ($trustedVerifierSha256 -cnotmatch '\A[0-9a-f]{64}\z') { throw 'Separately pinned verifier digest required.' }
$verifierItem = Get-Item -LiteralPath $trustedVerifier -Force
if ($verifierItem.PSIsContainer -or ($verifierItem.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Trusted verifier refused.' }
$verifierHandle = [IO.File]::Open($trustedVerifier,[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
try {
  $sha = [Security.Cryptography.SHA256]::Create()
  try { $digest = [BitConverter]::ToString($sha.ComputeHash($verifierHandle)).Replace('-','').ToLowerInvariant() } finally { $sha.Dispose() }
  if ($digest -cne $trustedVerifierSha256) { throw 'Trusted verifier digest mismatch.' }
  $verifierHandle.Position = 0
  $reader = [IO.StreamReader]::new($verifierHandle,[Text.UTF8Encoding]::new($false,$true),$false,4096,$true)
  try { $verifierCode = $reader.ReadToEnd() } finally { $reader.Dispose() }
  & ([scriptblock]::Create($verifierCode)) -Candidate $candidate
  if (-not $?) { throw 'Complete candidate verification refused.' }
} finally { $verifierHandle.Dispose() }
$script = Join-Path $candidate 'scripts\pull-production-backup.mjs'
foreach ($path in @((Join-Path $candidate 'scripts'), $script)) {
  $entry = Get-Item -LiteralPath $path -Force
  if (($entry.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0) {
    throw 'Script redirection refused.'
  }
}
if (-not (Get-Item -LiteralPath (Join-Path $candidate 'scripts') -Force).PSIsContainer -or
    (Get-Item -LiteralPath $script -Force).PSIsContainer) {
  throw 'Candidate scripts directory and script file required.'
}
# Private inputs/destination stay outside the repository and candidate tree,
# within the approved C:\Nexus Backup boundary; these are example values only.
& 'C:\Program Files\nodejs\node.exe' $script `
  --host 'backup.example.invalid' --user 'nexus-backup' `
  --key 'C:\Nexus Backup\keys\pull-key' --remote '/srv/nexus/shared/backups' `
  --verification-key 'C:\Nexus Backup\keys\pinned-verification.pem' `
  --recipient-fingerprint $recipientFingerprint `
  --destination 'C:\Nexus Backup\backups' --project 'nexus_prod_example' `
  --daily 3 --weekly 2 --monthly 3 `
  --private-config 'C:\Nexus Backup\config\pull-private.json'
exit $LASTEXITCODE
