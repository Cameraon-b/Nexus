# Copy OUTSIDE the repository; replace every example before use.
# NEXUS_COMMIT must equal git rev-parse HEAD for builds (40 lowercase hex digits).
NEXUS_COMMIT=REPLACE_WITH_EXACT_GIT_COMMIT
NEXUS_HOST=nexus.aether.lab
NEXUS_SECRET_FILE=/absolute/private/path/database-password
NEXUS_BIND_IP=127.0.0.1
NEXUS_PORT=8088
# EXAMPLE addresses only. Verify non-overlap against Docker AND LAN/VPN routes.
# Reserve .2 outside each dynamic pool; do not use it for any other service.
NEXUS_SUBNET=10.253.100.0/24
NEXUS_DYNAMIC_RANGE=10.253.100.128/25
NEXUS_FRONTEND_IP=10.253.100.2
NEXUS_EDGE_SUBNET=10.253.101.0/24
NEXUS_EDGE_DYNAMIC_RANGE=10.253.101.128/25
# Actual immediate TLS proxy peer as seen by frontend (an exact IP preferred).
# This example assumes a TLS container statically assigned .2 on the edge network.
# A host OpenResty proxy may appear as a Docker gateway instead; inspect first.
NEXUS_EDGE_PROXY=10.253.101.2
