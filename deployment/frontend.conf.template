geo $realip_remote_addr $edge_trusted {
    default 0;
    ${NEXUS_EDGE_PROXY} 1;
}
map "$edge_trusted:$http_x_forwarded_proto" $forward_scheme {
    default $scheme;
    "1:https" https;
}
server {
    listen 8080;
    server_name ${NEXUS_HOST};
    root /usr/share/nginx/html;
    autoindex off;
    client_max_body_size 1m;
    set_real_ip_from ${NEXUS_EDGE_PROXY};
    real_ip_header X-Forwarded-For;
    real_ip_recursive off;
    location = /health/frontend { access_log off; default_type application/json; return 200 '{"status":"alive"}'; }
    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forward_scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location /health/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $forward_scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location / { try_files $uri $uri/ /index.html; }
}
